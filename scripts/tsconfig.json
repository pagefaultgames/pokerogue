{
  "extends": "../tsconfig.json",
  "files": [],
  "include": ["**/*.ts", "../**/*.d.ts", "**/*.mjs", "**/*.cjs"],
  "exclude": ["../dist", "../node_modules", "**/*.boilerplate.ts"],
  "compilerOptions": {
    "types": ["@types/node"],
    "target": "esnext",
    "module": "preserve",
    "lib": ["ESNext"],
    "moduleResolution": "bundler", // we use vite-node
    "strict": true,
    // NB: Since `tsc` re-typechecks everything transitively imported by any compiled files, we should ensure that any imported files
    // have as few dependencies as possible (potentially by moving unrelated code into new files).
    // TODO: Consider if we can remove some of these import paths to discourage relying on import-heavy folders that may slow down compilation
    "paths": {
      "#abilities/*": ["../src/data/abilities/*.ts"],
      "#api/*": ["../src/plugins/api/*.ts"],
      "#biomes/*": ["../src/data/balance/biomes/*.ts"],
      "#balance/*": ["../src/data/balance/*.ts"],
      "#constants/*": ["../src/constants/*.ts"],
      "#enums/*": ["../src/enums/*.ts"],
      "#events/*": ["../src/events/*.ts"],
      "#field/*": ["../src/field/*.ts"],
      "#init/*": ["../src/init/*.ts"],
      "#inputs/*": ["../src/configs/inputs/*.ts"],
      "#modifiers/*": ["../src/modifier/*.ts"],
      "#moves/*": ["../src/data/moves/*.ts"],
      "#mystery-encounters/*": [
        "../src/data/mystery-encounters/utils/*.ts",
        "../src/data/mystery-encounters/encounters/*.ts",
        "../src/data/mystery-encounters/requirements/*.ts",
        "../src/data/mystery-encounters/*.ts"
      ],
      "#package.json": ["../package.json"],
      "#phases/*": ["../src/phases/*.ts"],
      "#plugins/*": ["../src/plugins/vite/*.ts", "../src/plugins/*.ts"],
      "#sprites/*": ["../src/sprites/*.ts"],
      "#system/*": [
        "../src/system/settings/*.ts",
        "../src/system/version-migration/versions/*.ts",
        "../src/system/version-migration/*.ts",
        "../src/system/*.ts"
      ],
      "#trainers/*": ["../src/data/trainers/*.ts"],
      "#types/*": ["../src/@types/*.ts"],
      "#ui/*": [
        "../src/ui/battle-info/*.ts",
        "../src/ui/containers/*.ts",
        "../src/ui/handlers/*.ts",
        "../src/ui/settings/*.ts",
        "../src/ui/utils/*.ts",
        "../src/ui/*.ts"
      ],
      "#utils/*": ["../src/utils/*.ts", "./utils/*.ts"],
      "#data/*": ["../src/data/pokemon-forms/*.ts", "../src/data/pokemon/*.ts", "../src/data/*.ts"],
      "#test/*": ["../test/*.ts"],
      "#app/*": ["../src/*.ts"],

      // new paths for script subfolders
      "#daily-seed/*": ["./daily-seed/*.ts", "./daily-seed/prompts/*.ts"],
      "#gen-moveset/*": ["./gen-moveset/*.ts"],
      "#create-test/*": ["./create-test/*.ts"]
    }
  }
}
